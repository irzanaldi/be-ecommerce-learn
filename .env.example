# Salin file ini menjadi .env dan sesuaikan nilainya.
# Aplikasi membaca konfigurasi dari environment variables (lihat internal/config/config.go).
# Nilai di bawah adalah placeholder/aman untuk pengembangan lokal — JANGAN taruh secret asli di sini.

APP_ENV=development
PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ecommerce

# JWT (WAJIB ganti dengan nilai acak yang kuat di lingkungan nyata)
JWT_SECRET=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
